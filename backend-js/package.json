{
  "name": "outpost-backend-js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --maxWorkers=1",
    "test:db": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/db --maxWorkers=1",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "busboy": "^1.6.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.14",
    "nodemailer": "10.0.10",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.16.3",
    "redis": "6.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "argon2@0.45.1": true
  }
}
