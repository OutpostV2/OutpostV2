OUTPOST_ENV=development
OUTPOST_LOG_LEVEL=INFO
OUTPOST_DATABASE_URL=postgresql+psycopg://outpost:outpost-local-dev-only@127.0.0.1:5433/outpost

# Required for login: supply a cryptographically random secret of at least 32 bytes.
# OUTPOST_AUTH_SIGNING_KEY=<set-in-local-env-or-secret-store>

# Delivers local development messages to the Mailpit service from docker-compose.yml.
OUTPOST_EMAIL_PROVIDER=smtp
OUTPOST_EMAIL_FROM_ADDRESS=no-reply@outpost.example
OUTPOST_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
OUTPOST_PASSWORD_RESET_URL=http://localhost:5173/reset-password
OUTPOST_EMAIL_SMTP_HOST=127.0.0.1
OUTPOST_EMAIL_SMTP_PORT=1025
OUTPOST_EMAIL_SMTP_TIMEOUT_SECONDS=10
OUTPOST_EMAIL_SMTP_STARTTLS=false
# OUTPOST_EMAIL_SMTP_USERNAME=<set-when-required>
# OUTPOST_EMAIL_SMTP_PASSWORD=<set-in-local-env-or-secret-store>
